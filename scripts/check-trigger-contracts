#!/usr/bin/env python3
"""Reject contradictory labels before routing measurement; never invokes an agent."""
import runpy
import sys
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))


def contradictions(cases):
    seen, errors = {}, []
    for case in cases:
        key = " ".join(case["utterance"].casefold().split())
        prior = seen.get(key)
        if prior and prior["expected"] != case["expected"]:
            errors.append(f"{case['utterance']!r}: {prior['expected']} in "
                          f"{prior['suite']} conflicts with {case['expected']} in {case['suite']}")
        seen[key] = case
    return errors


def main():
    cases = runpy.run_path(str(ROOT / "scripts/eval-trigger"))["load_cases"](["all"])
    errors = contradictions(cases)
    for error in errors:
        print("FAIL: " + error, file=sys.stderr)
    if not errors:
        print(f"OK: {len(cases)} trigger labels have no contradictory normalized prompts")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
