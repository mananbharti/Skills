#!/usr/bin/env python3
"""eval-outcome — baseline-vs-skill outcome trials for one skill.

Same task, same agent/model/tools/environment; the only intended
difference is whether the skill's runtime files are in context.
Baseline gets the skill catalog (names + descriptions — exactly what a
runtime shows); treatment additionally gets the skill's SKILL.md body
with references available on demand in the copied package. Deterministic grading first; raw outputs preserved
including failures. Results: evals/results/<ts>-outcome-<skill>-<agent>.json
(gitignored).

Usage:
  scripts/eval-outcome --skill concierge --agent opencode --trials 3
  scripts/eval-outcome --skill concierge --agent codex --trials 3 --allow-paid
  scripts/eval-outcome --skill concierge --agent codex --trials 1 --heldout --allow-paid

Paid agents (codex) are default-deny: any run additionally requires
--allow-paid AND ALLOW_PAID_AGENT=1 (scripts/eval_guard.py, exit 4).
"""
import argparse, hashlib, json, os, re, shlex, shutil, subprocess, sys, tempfile, time
from pathlib import Path, PurePosixPath

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "scripts"))
from eval_guard import PAID_AGENTS, guard_paid_agent
from eval_isolation import (
    dir_manifest,
    isolation_env,
    isolation_record,
    repo_provenance,
)
RESULTS = os.path.join(ROOT, "evals", "results")
RESULTS_TMP = os.path.join(RESULTS, "tmp")

SCHEMA = "outcome/6"
# GRADER_VERSION tracks grading-semantics changes. v3 added workspace_pass /
# format_pass notes (objective correctness vs skill-format adherence) without
# changing overall pass semantics. v4 narrows the workdir-path strip so
# harness-plumbing residue (e.g. a permission-trace quoting
# <workdir>/.env) is never graded as a hallucinated path. outcome/2
# through outcome/4 tallies stay preserved and comparable except for this
# narrowed flag class, which is labeled wherever it matters.
GRADER_VERSION = "4"
# Cap for the retained workdir diff (audit evidence after cleanup).
WORKDIR_DIFF_CAP = 30000

AGENTS = {
    "codex": {"bin": "codex", "cmd": lambda p, m=None: ["codex", "exec", p]},
    "opencode": {"bin": "opencode",
                 "cmd": lambda p, m=None:
                     ["opencode", "run"] + (["-m", m] if m else []) + [p]},
}

ARROW = re.compile(r"\s*(?:→|->|>|,|;)\s*")


def frontmatter(path):
    """Return (name, description) — description may span continuation lines."""
    name, desc, in_fm, collecting = None, [], False, False
    with open(path, encoding="utf-8") as f:
        for i, raw in enumerate(f):
            line = raw.rstrip("\n")
            if i == 0 and line != "---":
                break
            if i > 0 and line == "---":
                break
            if i == 0:
                in_fm = True
                continue
            m = re.match(r"^([A-Za-z][A-Za-z0-9_-]*):\s*(.*)$", line)
            if m:
                collecting = m.group(1) == "description"
                if m.group(1) == "name":
                    name = m.group(2).strip()
                elif collecting and m.group(2):
                    desc.append(m.group(2).strip())
            elif collecting and line.strip():
                desc.append(line.strip())
    return name, " ".join(desc)


def catalog():
    skills = []
    for d in sorted(os.listdir(os.path.join(ROOT, "skills"))):
        p = os.path.join(ROOT, "skills", d, "SKILL.md")
        if os.path.isfile(p):
            n, desc = frontmatter(p)
            skills.append((n or d, desc))
    return skills


def skill_context(slug, reference_policy="on-demand"):
    """Entrypoint by default; explicit eager policy reproduces old context loading."""
    if reference_policy not in ("on-demand", "eager"):
        raise ValueError("unknown reference policy")
    base = os.path.join(ROOT, "skills", slug)
    parts = []
    with open(os.path.join(base, "SKILL.md"), encoding="utf-8") as f:
        text = f.read()
    body = re.sub(r"\A---\n.*?\n---\n", "", text, count=1, flags=re.S)
    parts.append(f"# {slug} SKILL.md\n{body}")
    refdir = os.path.join(base, "references")
    if reference_policy == "eager" and os.path.isdir(refdir):
        for fn in sorted(os.listdir(refdir)):
            if fn.endswith(".md"):
                with open(os.path.join(refdir, fn), encoding="utf-8") as f:
                    parts.append(f"# {slug} references/{fn}\n{f.read()}")
    if reference_policy == "on-demand":
        parts.append(f"Read task-relevant references or helpers from .eval-skill/{slug}/ "
                     "only when needed; the complete package is available locally.")
    return "\n\n".join(parts)


def load_tasks(slug, heldout):
    path = os.path.join(ROOT, "evals", "outcomes", f"{slug}-tasks.json")
    with open(path, encoding="utf-8") as f:
        tasks = json.load(f)
    return [t for t in tasks if t.get("heldout", False) == heldout]


def validate_task_files():
    """Validate every outcome task file without invoking an agent."""
    skills = {d for d in os.listdir(os.path.join(ROOT, "skills"))
              if os.path.isdir(os.path.join(ROOT, "skills", d))}
    task_dir = os.path.join(ROOT, "evals", "outcomes")
    files = sorted(fn for fn in os.listdir(task_dir)
                   if fn.endswith("-tasks.json"))
    file_skills = {fn.removesuffix("-tasks.json") for fn in files}
    errors = []
    for slug in sorted(skills - file_skills):
        errors.append(f"{slug}: missing outcome task file")
    for slug in sorted(file_skills - skills):
        errors.append(f"{slug}: outcome task file has no matching skill")

    fixture_root = os.path.join(ROOT, "benchmarks", "fixtures")
    task_count = 0
    for fn in files:
        slug = fn.removesuffix("-tasks.json")
        path = os.path.join(task_dir, fn)
        try:
            with open(path, encoding="utf-8") as f:
                tasks = json.load(f)
        except (OSError, json.JSONDecodeError) as exc:
            errors.append(f"{fn}: {exc}")
            continue
        if not isinstance(tasks, list) or not tasks:
            errors.append(f"{fn}: must contain a non-empty JSON array")
            continue
        seen = set()
        heldout = 0
        for index, task in enumerate(tasks, 1):
            task_count += 1
            label = f"{fn}[{index}]"
            if not isinstance(task, dict):
                errors.append(f"{label}: task must be an object")
                continue
            task_id = task.get("id")
            if not isinstance(task_id, str) or not task_id:
                errors.append(f"{label}: missing non-empty id")
            elif task_id in seen:
                errors.append(f"{label}: duplicate id {task_id!r}")
            else:
                seen.add(task_id)
            if not isinstance(task.get("request"), str) or not task["request"].strip():
                errors.append(f"{label}: missing non-empty request")
            expected = task.get("expected")
            if not isinstance(expected, (dict, list)) or not expected:
                errors.append(f"{label}: expected must be a non-empty object or list")
            elif isinstance(expected, list):
                if expected != ["direct"]:
                    errors.append(f"{label}: unsupported route expectation {expected!r}")
            elif expected.get("type") not in {
                "route", "hotseat", "pilot", "blueprint", "polish", "friction",
                "ditto", "frontpage", "spelunk",
            }:
                errors.append(f"{label}: unknown grader type {expected.get('type')!r}")
            if "timeout" in task and (type(task["timeout"]) is not int or task["timeout"] <= 0):
                errors.append(f"{label}: timeout must be a positive integer")
            if not isinstance(task.get("heldout"), bool):
                errors.append(f"{label}: heldout must be a boolean")
            if task.get("heldout") is True:
                heldout += 1
            fixture = task.get("fixture")
            if fixture is not None:
                if (not isinstance(fixture, str)
                        or not re.fullmatch(r"[A-Za-z0-9._-]+", fixture)
                        or fixture in (".", "..")
                        or not os.path.exists(os.path.join(fixture_root, fixture))):
                    errors.append(f"{label}: unknown or unsafe fixture {fixture!r}")
            verify = task.get("verify", [])
            if not isinstance(verify, list) or any(
                not isinstance(item, dict)
                or not isinstance(item.get("cmd"), str)
                or not item["cmd"].strip()
                or type(item.get("expect")) is not int
                for item in verify
            ):
                errors.append(
                    f"{label}: verify must contain non-empty commands and integer exits"
                )
            artifacts = task.get("artifacts", [])
            if not isinstance(artifacts, list) or any(
                not isinstance(item, str)
                or not item.strip()
                or os.path.isabs(item)
                or ".." in item.replace("\\", "/").split("/")
                for item in artifacts
            ):
                errors.append(f"{label}: artifacts must be safe relative glob strings")
        if heldout == 0:
            errors.append(f"{fn}: no held-out task")
        if heldout == len(tasks):
            errors.append(f"{fn}: no non-held-out task")
    return task_count, errors


def normalize_route(raw):
    m = re.search(r"^route:\s*(.+)$", raw, re.M | re.I)
    if not m:
        return None
    chain = m.group(1).strip().strip("`").lower()
    if chain in ("direct", "none"):
        return [chain]
    return [s.strip(" `") for s in ARROW.split(chain) if s.strip(" `")]


def grade_route(task, route, raw):
    """Deterministic routing grade. Returns (pass: bool, notes: dict)."""
    if route is None:
        return False, {"reason": "no parseable route: line"}
    exp = task["expected"]
    if exp == ["direct"]:
        return route == ["direct"], {"route": route}
    allowed = set(exp.get("allowed", []))
    required = set(exp.get("required", []))
    route_set = set(route)
    outside = sorted(route_set - allowed - {"direct", "none"})
    ordered = [s for s in route if s in allowed]
    # order_insensitive drops the sequence assertion where the task cannot
    # justify one (concierge C1: audit-before-fix and fix-before-audit are
    # both defensible for a combined refresh-plus-flow task). Containment,
    # required skills, and length still grade.
    if exp.get("order_insensitive"):
        order_ok = True
    else:
        order_ok = ordered == sorted(ordered, key=lambda s: exp["order"].index(s)) \
            if all(s in exp.get("order", []) for s in ordered) else True
    ok = (not outside and required <= route_set and order_ok
          and len(route) <= exp.get("max_len", 6))
    return ok, {"route": route, "outside": outside, "order_ok": order_ok}


PERSONAS = ["aanya", "kabir", "meera", "arjun", "naina", "rohan", "ishaan"]


def grade_hotseat(task, raw):
    """Deterministic proxies for debate quality (reviewer rubric stays separate)."""
    low = raw.lower()
    persona_count = sum(1 for p in PERSONAS if p in low)
    assum = len(re.findall(r"assum", low))
    has_mvp = "mvp" in low
    kill_at = low.find("kill")
    kill_num = bool(re.search(r"\d", low[kill_at:])) if kill_at != -1 else False
    has_matrix = bool(re.search(r"decision matrix", low))
    has_minority = bool(re.search(r"minority", low))
    ok = persona_count >= 5 and kill_num and has_mvp and assum >= 2
    return ok, {"persona_count": persona_count, "assumption_mentions": assum,
                "has_mvp": has_mvp, "kill_has_number": kill_num,
                "has_matrix": has_matrix, "has_minority": has_minority}


def grade(task, route, raw, obs=None):
    if obs is not None and obs.get("status") != "ok":
        return False, {"reason": "agent invocation did not succeed"}
    if (obs or {}).get("outer_repo_changed"):
        return False, {"reason": "outer repository changed",
                       "outer_repo_changed": obs["outer_repo_changed"]}
    required = task.get("verify", [])
    checks = (obs or {}).get("verify", [])
    if len(checks) != len(required) or any(
        actual.get("cmd") != expected["cmd"]
        or actual.get("exit") != expected.get("expect", 0)
        for expected, actual in zip(required, checks)
    ):
        return False, {"reason": "required verification missing or failed"}
    exp = task["expected"]
    if isinstance(exp, dict) and exp.get("type") == "hotseat":
        return grade_hotseat(task, raw)
    if isinstance(exp, dict) and exp.get("type") == "pilot":
        return grade_pilot(task, raw, obs or {})
    if isinstance(exp, dict) and exp.get("type") == "blueprint":
        return grade_blueprint(task, raw, obs or {})
    if isinstance(exp, dict) and exp.get("type") == "polish":
        return grade_polish(task, raw, obs or {})
    if isinstance(exp, dict) and exp.get("type") == "friction":
        # Audit-and-fix skills grade on the same artifact mechanics:
        # forbidden strings, file identity, required markers.
        return grade_polish(task, raw, obs or {})
    if isinstance(exp, dict) and exp.get("type") == "ditto":
        # Rebuild skills grade on the same artifact mechanics: tokens
        # inferred, trap strings absent, loop markers present.
        return grade_polish(task, raw, obs or {})
    if isinstance(exp, dict) and exp.get("type") == "frontpage":
        # README skills grade on the same artifact mechanics: invented
        # strings absent, real commands present, audit markers in chat.
        return grade_polish(task, raw, obs or {})
    if isinstance(exp, dict) and exp.get("type") == "spelunk":
        return grade_spelunk(task, raw, obs or {})
    return grade_route(task, route, raw)


def grade_blueprint(task, raw, obs):
    """Deliverable grading: diagrams exist, validate, nodes resolve, count restrained."""
    exp = task["expected"]
    artifacts = obs.get("artifacts") or {}
    mmds = sorted(p for p in artifacts if p.endswith(".mmd"))
    if not mmds:
        return False, {"reason": "no .mmd diagrams produced", "diagrams": 0}
    over = len(mmds) > exp.get("max_diagrams", 5)
    checks = obs.get("verify") or []
    failed_checks = [c["cmd"] for c in checks if c["exit"] != c.get("expect", 0)]
    body = "\n".join(artifacts[p] for p in mmds)
    known = fixture_files(task["fixture"]) if task.get("fixture") else []
    hallucinated = []
    checked = 0
    for tok in set(PATH_RE.findall(body)):
        tok = tok.lstrip("./")
        if not tok:
            continue
        checked += 1
        if not any(f == tok or f.endswith("/" + tok) for f in known):
            hallucinated.append(tok)
    low = (body + "\n" + raw).lower()
    must = [m.lower() for m in exp.get("must_contain", [])]
    missing = [m for m in must if m not in low]
    # Invented-infrastructure check: fixtures with no infra files of their own
    # must not sprout managed services. Word-boundary match on service names.
    suspect_infra = []
    if exp.get("forbid_infra"):
        infra_words = ["kafka", "kubernetes", "k8s", "redis", "cdn", "postgres",
                       "mysql", "mongodb", "rabbitmq", "elasticsearch", "docker",
                       "terraform", "nginx", "envoy", "istio", "prometheus",
                       "grafana", "replica", "shard", "queue"]
        suspect_infra = sorted(w for w in infra_words
                               if re.search(r"\b" + w + r"s?\b", low))
    ok = (not over and not failed_checks and not hallucinated and not missing
          and not suspect_infra)
    workspace_pass = (not over and not failed_checks and not hallucinated
                      and not suspect_infra)
    return ok, {"diagrams": len(mmds), "over_budget": over,
                "failed_checks": failed_checks, "missing": missing,
                "hallucinated_paths": sorted(hallucinated),
                "suspect_infra": suspect_infra,
                "paths_checked": checked,
                "workspace_pass": workspace_pass,
                "format_pass": not missing}


def grade_polish(task, raw, obs):
    """Artifact grading (polish, friction, ditto, frontpage): forbidden strings
    absent, named files byte-identical to the fixture where required,
    required markers present in artifacts and chat."""
    exp = task["expected"]
    artifacts = obs.get("artifacts") or {}
    if not artifacts:
        return False, {"reason": "no artifacts captured", "files": 0}
    body = "\n".join(artifacts[p] for p in sorted(artifacts))
    low_body = body.lower()
    low = raw.lower()
    forbid = [s.lower() for s in exp.get("forbid_present", [])]
    present_forbidden = sorted(s for s in forbid if s in low_body)
    # File identity: named artifacts must match fixture bytes exactly
    # (token preservation, audit-only restraint).
    changed_tokens = []
    for rel in exp.get("tokens_unchanged", []) + exp.get("files_unchanged", []):
        fp = os.path.join(ROOT, "benchmarks", "fixtures",
                          task["fixture"], rel)
        try:
            with open(fp, encoding="utf-8") as f:
                original = f.read()
        except OSError:
            changed_tokens.append(rel + " (fixture missing)")
            continue
        if artifacts.get(rel) != original:
            changed_tokens.append(rel)
    req = [s.lower() for s in exp.get("require_present", [])]
    missing = [s for s in req if s not in low_body]
    missing_groups = [g for g in exp.get("require_present_any", [])
                      if not any(alt.lower() in low_body for alt in g)]
    must = [m.lower() for m in exp.get("must_contain", [])]
    missing_chat = [m for m in must if m not in low]
    chat_groups = [g for g in exp.get("must_contain_any", [])
                   if not any(alt.lower() in low for alt in g)]
    checks = (obs or {}).get("verify") or []
    failed_checks = [c.get("cmd", "?") for c in checks
                     if c.get("exit") != c.get("expect", 0)]
    ok = (not present_forbidden and not changed_tokens and not missing
          and not missing_groups and not missing_chat and not chat_groups
          and not failed_checks)
    workspace_pass = (not present_forbidden and not changed_tokens and not missing
                      and not missing_groups and not failed_checks)
    return ok, {"files": len(artifacts),
                "forbidden_present": present_forbidden,
                "tokens_changed": changed_tokens,
                "missing_artifact": missing,
                "missing_artifact_groups": missing_groups,
                "missing_chat": missing_chat,
                "missing_chat_groups": chat_groups,
                "failed_checks": failed_checks,
                "workspace_pass": workspace_pass,
                "format_pass": not missing_chat and not chat_groups}


def grade_pilot(task, raw, obs):
    """Workspace grading: verify-command exits + scope containment + report markers."""
    exp = task["expected"]
    checks = (obs.get("verify") or [])
    failed_checks = [c["cmd"] for c in checks if c["exit"] != c.get("expect", 0)]
    scope = exp.get("scope", [])
    changed = obs.get("changed_files", [])
    outside = [f for f in changed
               if PurePosixPath(f).is_absolute() or ".." in PurePosixPath(f).parts
               or (scope and not any(f == s.rstrip("/")
                                     or f.startswith(s.rstrip("/") + "/")
                                     for s in scope))]
    low = raw.lower()
    must = [m.lower() for m in exp.get("must_contain", [])]
    missing = [m for m in must if m not in low]
    missing_groups = [g for g in exp.get("must_contain_any", [])
                      if not any(alt.lower() in low for alt in g)]
    contaminants = [c for c in exp.get("must_not", []) if c.lower() in low]
    ok = (not failed_checks and not outside and not missing
          and not missing_groups and not contaminants)
    workspace_pass = not failed_checks and not outside
    return ok, {"failed_checks": failed_checks, "outside_scope": outside,
                "changed_files": changed, "missing": missing,
                "missing_groups": missing_groups,
                "contaminants": contaminants,
                "workspace_pass": workspace_pass,
                "format_pass": not missing and not missing_groups and not contaminants}


PATH_RE = re.compile(r"[\w\-./]*\.(?:ts|tsx|js|jsx|json|html|css|py|txt|md|toml|yaml|yml|lock|env|gitignore|sh|sqlite|db)\b")

# Negation cues that turn a path/token mention into an absence denial
# ("no X in the copy"), not an existence claim. Shared by the
# hallucinated-path and contaminant gates.
_NEG_RE = re.compile(r"\b(no|not|without|missing|never|neither|nor|absent|avoid|excluding|none|nonexistent)\b")

# Bare technology names that collide with PATH_RE (Next.js ends in .js)
# but are library mentions, never file claims. Lowercase, slash-free
# tokens only; a real fixture file with such a name still passes on
# the basename rule, so this only rescues would-be false flags.
_TECH_NAMES = frozenset({
    "next.js", "vue.js", "node.js", "react.js", "express.js", "d3.js",
    "three.js", "chart.js", "ember.js", "backbone.js", "nuxt.js",
    "gatsby.js", "jquery.js", "svelte.js", "alpine.js", "meteor.js",
    "mithril.js", "knockout.js",
})

_PROBE_LINE_RE = re.compile(r"(?:ls|cat|stat|head|tail|file|find)\b|test\s+-")


def _is_probe_occurrence(line, idx):
    """True when the token at idx is a shell-probe argument, not a claim.

    Covers backticked commands (`ls X`), shell-prompt lines, and lines
    starting with an inspection command. Case-sensitive on purpose:
    prose starting with capital "Test" is not a shell command.
    """
    if line[:idx].count("`") % 2 == 1:
        return True
    stripped = line.strip()
    if stripped[:1] in ("$", ">", "#"):
        return True
    if _PROBE_LINE_RE.match(stripped):
        return True
    return False


def fixture_files(name):
    out = []
    base = os.path.join(ROOT, "benchmarks", "fixtures", name)
    for dirpath, _, filenames in os.walk(base):
        for fn in filenames:
            full = os.path.join(dirpath, fn)
            out.append(os.path.relpath(full, base))
    return out


def grade_spelunk(task, raw, obs=None):
    """Fact recall + contaminant + hallucinated-path check against the fixture.

    Also enforces verify-command exits when the task declares them
    (previously ignored — a task with verify gates graded chat only)."""
    low = raw.lower()
    exp = task["expected"]
    must = [m.lower() for m in exp.get("must_contain", [])]
    missing = [m for m in must if m not in low]
    missing_groups = [g for g in exp.get("must_contain_any", [])
                      if not any(alt.lower() in low for alt in g)]
    # Negation-aware contaminant gate: an absence denial ("no Dockerfile
    # in the copy") is honest scoping, not forbidden-scope smuggling. A
    # contaminant counts only with at least one non-negated occurrence.
    contaminants = []
    for cand in exp.get("must_not", []):
        low_c = cand.lower()
        start = 0
        while True:
            idx = low.find(low_c, start)
            if idx < 0:
                break
            if not _NEG_RE.search(low[max(0, idx - 60):idx]):
                contaminants.append(cand)
                break
            start = idx + len(low_c)
    # Hallucinated-path grading needs a fixture ground truth. Chat-only
    # tasks (no fixture) would flag every filename mention — technology
    # names like "Next.js" match PATH_RE — as invented paths, so the
    # check is fixture-gated (caught by headroom/opencode 2026-09-15).
    known = fixture_files(task["fixture"]) if task.get("fixture") else None
    # The sandbox path is harness plumbing, not a repo claim: agents quote
    # it when reading fixture files ("…/outcome-XXXX/.env"). Strip the
    # workdir (recorded per-trial; regex fallback for results saved before
    # that) before any path-existence grading.
    wd = (obs or {}).get("workdir")
    if wd and wd in raw:
        # Remove the workdir plus any appended path components in one
        # pass: a tool trace quoting <workdir>/tests/test_shop.py must
        # not leave "/tests/test_shop.py" behind as a fake repo claim.
        raw = re.sub(re.escape(wd) + r"(?:/[\w.\-]+)*", "", raw)
    # Harness plumbing is never a repo claim: strip the sandbox path even
    # when a tool trace appends a filename to it (e.g. a permission
    # auto-rejection quoting <workdir>/.env leaves "/.env" behind after a
    # bare workdir strip, which then false-flags as invented). The optional
    # trailing component covers one appended filename; deeper real paths
    # are still checked against the fixture below.
    raw = re.sub(r"[\w./-]*evals/results/tmp/outcome-[0-9a-z_]+(?:/[\w.-]+)?", "", raw)
    hallucinated = []
    checked = 0
    # Declared skill outputs are plans, not existence claims: the
    # contracted output paths below are written by the agent as
    # deliverables and must never count as invented fixture paths.
    output_prefixes = ("docs/plans/", "docs/briefs/", "docs/research/")
    # Fixture-quoted content is a quote, not a claim: a token that
    # appears verbatim inside fixture file text (e.g. a connection
    # string naming a database file that is not itself a tracked file)
    # is excluded from hallucination grading.
    quoted = set()
    if known is not None:
        base = os.path.join(ROOT, "benchmarks", "fixtures", task["fixture"])
        for dirpath, _, filenames in os.walk(base):
            for fn in filenames:
                try:
                    with open(os.path.join(dirpath, fn), encoding="utf-8",
                              errors="replace") as handle:
                        text = handle.read()
                except OSError:
                    continue
                for raw_tok in set(PATH_RE.findall(text)):
                    tok = raw_tok[2:] if raw_tok.startswith("./") else raw_tok
                    if tok:
                        quoted.add(tok)
                        quoted.add(os.path.basename(tok))
        lines = raw.splitlines()
    if known is not None:
        for raw_tok in set(PATH_RE.findall(raw)):
            # Bare dotfile mentions (".env") are names, not path claims -
            # without this, any required finding about dotfiles false-fails.
            if raw_tok.startswith(".") and "/" not in raw_tok:
                continue
            # Strip only a literal "./" prefix; lstrip("./") mangles
            # dotfiles (".gitignore" -> "gitignore") into hallucinations.
            tok = raw_tok[2:] if raw_tok.startswith("./") else raw_tok
            if not tok:
                continue
            if tok.startswith(output_prefixes) or tok == "docs/plans":
                continue
            if tok in quoted:
                continue
            # Bare technology names (Next.js) are library mentions that
            # collide with the path regex, never file claims.
            if "/" not in tok and tok.lower() in _TECH_NAMES:
                continue
            checked += 1
            # An occurrence is an existence claim only when it is neither
            # a negated absence denial ("no X in the copy") nor a shell
            # probe (`ls X`, `test -f X`). A token counts as claimed with
            # at least one claiming occurrence.
            claimed = False
            for line in lines:
                low_line = line.lower()
                low_tok = tok.lower()
                start = 0
                while True:
                    idx = low_line.find(low_tok, start)
                    if idx < 0:
                        break
                    if (not _NEG_RE.search(low_line[max(0, idx - 60):idx])
                            and not _is_probe_occurrence(line, idx)):
                        claimed = True
                        break
                    start = idx + len(low_tok)
                if claimed:
                    break
            if not claimed:
                continue
            if not any(f == tok or f.endswith("/" + tok)
                       or os.path.basename(f) == os.path.basename(tok) and
                       tok.count("/") == 0 for f in known):
                hallucinated.append(tok)
    recall = (len(must) - len(missing)) / max(len(must), 1)
    line_count = len(raw.strip().splitlines())
    over_budget = (exp.get("max_lines") is not None
                   and line_count > exp["max_lines"])
    checks = (obs or {}).get("verify") or []
    failed_checks = [c.get("cmd", "?") for c in checks
                     if c.get("exit") != c.get("expect", 0)]
    ok = (not missing and not missing_groups and not contaminants
          and not hallucinated and not over_budget and not failed_checks)
    return ok, {"recall": round(recall, 2), "missing": missing,
                "missing_groups": missing_groups,
                "contaminants": contaminants,
                "hallucinated_paths": sorted(hallucinated),
                "paths_checked": checked, "line_count": line_count,
                "over_budget": over_budget,
                "failed_checks": failed_checks,
                "workspace_pass": not failed_checks,
                "format_pass": not missing and not missing_groups and not contaminants
                and not hallucinated and not over_budget}


def _root_status():
    """Fingerprint tracked and unignored files, including already dirty files."""
    result = subprocess.run(
        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
        capture_output=True, text=True, cwd=ROOT, check=True,
    )
    snapshot = {}
    for name in set(result.stdout.split("\0")) - {""}:
        path = Path(ROOT) / name
        if path.is_symlink():
            snapshot[name] = ("symlink", os.readlink(path))
        elif path.is_file():
            snapshot[name] = (path.stat().st_mode,
                              hashlib.sha256(path.read_bytes()).hexdigest())
        else:
            snapshot[name] = None
    return snapshot


def observe(agent, prompt, cfg, timeout, model=None, fixture=None,
            verify=None, artifacts=None, skill=None):
    os.makedirs(RESULTS_TMP, exist_ok=True)
    workdir = tempfile.mkdtemp(prefix="outcome-", dir=RESULTS_TMP)
    # Containment: the agent must work ONLY inside workdir. Pin it in
    # the prompt (agents otherwise wander to absolute repo paths they
    # infer) and monitor the outer repo for stray writes.
    prompt = ("Your working repository copy is EXACTLY this directory:\n"
              f"{workdir}\n"
              "Do ALL file reads, writes, edits, and shell commands under "
              "it. Never read, write, or reference files by absolute paths "
              "outside it. Your shell starts there.\n\n" + prompt)
    t0 = time.time()
    try:
        pre_outer = _root_status()
        fixture_manifest = None
        if fixture:
            src = Path(ROOT) / "benchmarks" / "fixtures" / fixture
            fixture_manifest = dir_manifest(str(src))
            if src.is_dir():
                shutil.copytree(src, workdir, dirs_exist_ok=True)
            else:
                shutil.copy2(src, Path(workdir) / src.name)
        if skill:
            package = Path(workdir) / ".eval-skill" / skill
            shutil.copytree(Path(ROOT) / "skills" / skill, package)
            prompt += f"\nThe active skill's complete package is at {package}.\n"
        subprocess.run(["git", "init", "-q", workdir], capture_output=True, check=True)
        # A pristine commit makes unchanged fixture files disappear from status.
        subprocess.run(["git", "-C", workdir, "add", "-A"],
                       capture_output=True, check=True)
        subprocess.run(["git", "-C", workdir, "-c", "user.name=fixture",
                        "-c", "user.email=fixture@example.com",
                        "-c", "commit.gpgsign=false", "commit", "--allow-empty",
                        "-qm", "pristine fixture"], capture_output=True, check=True)
        proc = subprocess.run(cfg["cmd"](prompt, model), capture_output=True,
                              text=True, timeout=timeout, cwd=workdir,
                              stdin=subprocess.DEVNULL,
                              env={**os.environ, **isolation_env(agent)})
        out = (proc.stdout or "") + (proc.stderr or "")
        # Long-form skills (debates, audits) put the graded synthesis last:
        # keep head (framing) + tail (verdict) instead of head-only truncation.
        if len(out) > 60000:
            out = out[:20000] + "\n…[truncated]…\n" + out[-40000:]
        obs = {"status": "ok" if proc.returncode == 0 else "error",
               "exit": proc.returncode, "output": out,
               "output_chars": len((proc.stdout or "") + (proc.stderr or "")),
               "workdir": workdir,
               "fixture_manifest": fixture_manifest,
               "duration": round(time.time() - t0, 1)}
        if verify:
            # Execution skills are graded on the workspace, not the chat:
            # run check commands and record the changed-file set BEFORE cleanup.
            checks = []
            for v in verify:
                cmd = v["cmd"].replace("{ROOT}", shlex.quote(ROOT))
                try:
                    r = subprocess.run(cmd, shell=True, capture_output=True,
                                       text=True, timeout=120, cwd=workdir)
                    checks.append({"cmd": v["cmd"], "exit": r.returncode,
                                   "expect": v.get("expect", 0),
                                   "tail": ((r.stdout or "") + (r.stderr or ""))[-1500:]})
                except subprocess.TimeoutExpired:
                    checks.append({"cmd": v["cmd"], "exit": None,
                                   "expect": v.get("expect", 0), "tail": "TIMEOUT"})
            st = subprocess.run(["git", "-c", "status.renames=false", "status",
                                 "--porcelain", "-z", "--untracked-files=all"],
                                capture_output=True, text=True, cwd=workdir, check=True)
            raw_changed = [item[3:] for item in st.stdout.split("\0") if item]
            # Tool noise is never agent work: drop bytecode caches (mirrors
            # .gitignore). Without this, any Python trial false-fails scope.
            changed = [f for f in raw_changed
                       if "__pycache__" not in f and not f.endswith(".pyc")]
            obs["verify"] = checks
            obs["changed_files"] = changed
            tree = []
            for dirp, _, fns in os.walk(workdir):
                if ".git" in dirp.split(os.sep):
                    continue
                for fn in fns:
                    tree.append(os.path.relpath(os.path.join(dirp, fn),
                                                workdir))
            obs["workdir_tree"] = sorted(tree)
        if artifacts:
            # Deliverable skills are graded on produced files: capture capped
            # contents of glob-matched artifacts BEFORE cleanup.
            import glob as _glob
            captured = {}
            for pat in artifacts:
                for match in sorted(_glob.glob(pat, root_dir=workdir, recursive=True)):
                    path = Path(workdir) / match
                    if not path.resolve().is_relative_to(Path(workdir).resolve()):
                        raise ValueError(f"artifact escapes evaluation directory: {match}")
                    if not path.is_file():
                        continue
                    with path.open(encoding="utf-8",
                              errors="replace") as f:
                        content = f.read(20001)
                    if len(content) > 20000:
                        raise ValueError(f"artifact exceeds capture limit: {match}")
                    captured[match] = content
            obs["artifacts"] = captured
        # Audit evidence: capped unified diff of everything the agent did,
        # retained after the workdir is removed. Hash-pinned provenance
        # lives in the record; this diff is the human-auditable residue.
        try:
            diff_proc = subprocess.run(
                ["git", "-c", "status.renames=false", "diff", "HEAD", "--",
                 ".", ":(exclude).git"],
                capture_output=True, text=True, cwd=workdir, timeout=120)
            diff_text = diff_proc.stdout if diff_proc.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            diff_text = ""
        obs["workdir_diff_truncated"] = len(diff_text) > WORKDIR_DIFF_CAP
        obs["workdir_diff"] = diff_text[:WORKDIR_DIFF_CAP]
        obs["isolation"] = isolation_record(agent, workdir)
        post_outer = _root_status()
        obs["outer_repo_changed"] = sorted(
            name for name in pre_outer.keys() | post_outer.keys()
            if pre_outer.get(name) != post_outer.get(name)
        )
        return obs
    except subprocess.TimeoutExpired as exc:
        partial = exc.stdout or b""
        if isinstance(partial, bytes):
            partial = partial.decode("utf-8", errors="replace")
        return {"status": "error", "error": "timeout", "output": partial[-60000:],
                "duration": round(time.time() - t0, 1)}
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        return {"status": "error", "error": str(exc),
                "duration": round(time.time() - t0, 1)}
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


def build_prompt(task, cat, treatment_text):
    lines = ["You are a coding assistant with these skills installed (name: when to use):"]
    lines += [f"- {n}: {d}" for n, d in cat]
    if treatment_text:
        lines += ["\nThe following skill is active — follow it:\n", treatment_text]
        lines += [f"\nUser request: \"{task['request']}\"",
                  task.get("instruction_treatment", task.get("instruction", ""))]
    else:
        lines += [f"\nUser request: \"{task['request']}\"",
                  task.get("instruction_baseline", task.get("instruction", ""))]
    return "\n".join(lines)


def save_result(record, path):
    """Checkpoint each completed trial atomically, including failed observations."""
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="utf-8") as stream:
        json.dump(record, stream, indent=2)
    os.replace(temporary, path)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--skill")
    ap.add_argument("--check", action="store_true",
                    help="validate all outcome task files without invoking an agent")
    ap.add_argument("--agent", default="codex", choices=list(AGENTS))
    ap.add_argument("--trials", type=int, default=3)
    ap.add_argument("--timeout", type=int, default=180)
    ap.add_argument("--heldout", action="store_true")
    ap.add_argument("--task", default=None, metavar="TASK_ID",
                    help="run one task by id (e.g. C1 post-exploratory "
                         "validation tasks run only this way, never in batch "
                         "sweeps). Searches held-out and regular tasks; "
                         "combined with --heldout the task must belong to "
                         "that subset. Recorded.")
    ap.add_argument("--model", default=None,
                    help="model id passed to the agent CLI (e.g. "
                         "opencode/muse-spark-1.3-contributor-free); recorded in the "
                         "result JSON — results are model-scoped")
    ap.add_argument("--reference-policy", choices=["on-demand", "eager"],
                    default="on-demand",
                    help="load only SKILL.md initially (default); eager includes all "
                         "references to reproduce historical context loading")
    ap.add_argument("--timeout-override", type=int, default=None,
                    help="replace per-task timeouts (slow free models); "
                         "plumbing only — no grading gate changes; "
                         "recorded in the result JSON")
    ap.add_argument("--order", choices=["fixed", "alternating"], default="alternating",
                    help="condition order per (task, trial): fixed runs baseline "
                         "then treatment every time (legacy bias: treatment always "
                         "second); alternating counterbalances (even trials "
                         "baseline-first, odd trials treatment-first). Recorded "
                         "per trial.")
    ap.add_argument("--resume-from", default=None, metavar="RESULT_JSON",
                    help="resumable batches: the output contains the COMPLETE "
                         "combined trial set — copied source rows (marked "
                         "resumed) plus newly executed rows — in a NEW file. "
                         "The source file is never modified. Experiment "
                         "identity must match (schema, grader, skill, agent, "
                         "model, heldout, task contracts, task filter, order, "
                         "timeouts).")
    ap.add_argument("--allow-paid", action="store_true",
                    help="with ALLOW_PAID_AGENT=1, authorize a paid-agent run (codex)")
    a = ap.parse_args()

    if a.check:
        task_count, errors = validate_task_files()
        if errors:
            for error in errors:
                print(f"FAIL: {error}", file=sys.stderr)
            return 1
        print(f"OK: {task_count} outcome tasks well-formed across 28 skills")
        return 0
    if not a.skill:
        ap.error("--skill is required for a live run")
    if a.skill not in {name for name, _ in catalog()}:
        ap.error(f"unknown skill {a.skill!r}")
    if a.trials <= 0 or a.timeout <= 0 or (a.timeout_override is not None and a.timeout_override <= 0):
        ap.error("trials and timeouts must be positive")
    try:
        max_consec = int(os.environ.get("EO_MAX_CONSEC", "0") or 0)
        if max_consec < 0:
            raise ValueError
    except ValueError:
        ap.error("EO_MAX_CONSEC must be a non-negative integer")
    _, errors = validate_task_files()
    if errors:
        for error in errors:
            print(f"FAIL: {error}", file=sys.stderr)
        return 2

    guard_paid_agent(a.agent, a.allow_paid)

    cfg = AGENTS[a.agent]
    if shutil.which(cfg["bin"]) is None:
        print(f"UNAVAILABLE: {cfg['bin']} not installed", file=sys.stderr)
        return 3

    try:
        aver = subprocess.run([cfg["bin"], "--version"], capture_output=True,
                              text=True, timeout=15).stdout.strip()[:80]
    except Exception:
        aver = "unknown"
    commit = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=ROOT,
                            capture_output=True, text=True).stdout.strip()
    cat = catalog()
    treat = skill_context(a.skill, a.reference_policy)
    if a.task:
        pool = load_tasks(a.skill, True) + load_tasks(a.skill, False)
        tasks = [t for t in pool if t.get("id") == a.task]
        if not tasks:
            print(f"unknown task {a.task!r} for skill {a.skill}", file=sys.stderr)
            return 2
        if a.heldout and not tasks[0].get("heldout", False):
            print(f"task {a.task!r} is not held-out; refusing --heldout combo",
                  file=sys.stderr)
            return 2
    else:
        # Sweeps never spend validation budget: confirm_only tasks run
        # solely via explicit --task. Explicit --task may still target any
        # task (validation or ordinary, e.g. for debugging).
        tasks = [t for t in load_tasks(a.skill, a.heldout)
                 if not t.get("confirm_only", False)]
    if not tasks:
        print("no tasks for this selection", file=sys.stderr)
        return 2

    rec = {"schema": SCHEMA, "grader_version": GRADER_VERSION,
           "skill": a.skill, "agent": a.agent,
           "agent_version": aver, "model": a.model or "agent-default",
           "timeout_override": a.timeout_override,
           "commit": commit,
           "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
           "paid_guard": "authorized" if a.agent in PAID_AGENTS else "n/a",
           "heldout": a.heldout, "status": "running", "trials": [],
           "task_contracts": tasks,
           "runner_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
           "provenance": {
               **repo_provenance(ROOT, __file__),
               "grader_version": GRADER_VERSION,
               "skill_package": dir_manifest(
                   os.path.join(ROOT, "skills", a.skill)),
               "checkers": dir_manifest(os.path.join(ROOT, "scripts")),
               "fixtures": {name: dir_manifest(os.path.join(ROOT, "benchmarks", "fixtures", name))
                            for name in sorted({task["fixture"] for task in tasks if task.get("fixture")})},
               "treatment_context_sha256": hashlib.sha256(treat.encode()).hexdigest(),
               "requested_model": a.model,
               "agent_version": aver,
               "settings": {
                   "trials": a.trials,
                   "timeout_default": a.timeout,
                   "timeout_override": a.timeout_override,
                   "max_consec": max_consec,
                   "order": a.order,
                   "task_filter": a.task,
                   "reference_policy": a.reference_policy,
               },
               "isolation": isolation_record(a.agent),
               "started": time.strftime("%Y-%m-%dT%H:%M:%S"),
           }}
    if a.resume_from:
        try:
            with open(a.resume_from, encoding="utf-8") as f:
                prior = json.load(f)
        except (OSError, json.JSONDecodeError) as exc:
            print(f"cannot read --resume-from file: {exc}", file=sys.stderr)
            return 2
        if prior.get("schema") != SCHEMA:
            print(f"--resume-from schema is {prior.get('schema')!r}; "
                  f"this runner writes {SCHEMA} — refusing to mix versions "
                  f"(historical results are preserved, never rewritten)",
                  file=sys.stderr)
            return 2
        # Strict experiment identity: every field that changes the meaning
        # of a trial must match. The trials count is intentionally excluded
        # (extending a batch is the point of resume).
        mismatches = []
        for key in ("skill", "agent", "heldout"):
            if prior.get(key) != rec[key]:
                mismatches.append(f"{key} is {prior.get(key)!r}, requested {rec[key]!r}")
        prior_settings = (prior.get("provenance") or {}).get("settings") or {}
        for key in ("timeout_default", "timeout_override", "order", "task_filter", "reference_policy"):
            if prior_settings.get(key) != rec["provenance"]["settings"][key]:
                mismatches.append(f"settings.{key} differs")
        if prior.get("grader_version") != GRADER_VERSION:
            mismatches.append("grader_version differs")
        if prior.get("model") != rec["model"]:
            mismatches.append("model differs")
        if prior.get("task_contracts") != rec["task_contracts"]:
            mismatches.append("task_contracts differ")
        if prior.get("runner_sha256") != rec["runner_sha256"]:
            mismatches.append("runner implementation differs")
        for key in ("skill_package", "checkers", "fixtures", "treatment_context_sha256", "agent_version"):
            if (prior.get("provenance") or {}).get(key) != rec["provenance"][key]:
                mismatches.append(f"provenance.{key} differs")
        if mismatches:
            print("--resume-from identity mismatch: " + "; ".join(mismatches) + " — "
                  "refusing (source preserved, nothing written)",
                  file=sys.stderr)
            return 2
        prior_rows = prior.get("trials", [])
        identities = [(row.get("task"), row.get("condition"), row.get("trial"))
                      for row in prior_rows]
        if len(set(identities)) != len(identities):
            print("--resume-from source contains duplicate trial identities "
                  "(task, condition, trial) — refusing (source preserved, "
                  "nothing written)", file=sys.stderr)
            return 2
        done = set(identities)
        # Combined trial set: marked copies first (source file untouched),
        # newly executed rows appended by the loop below. Summaries at the
        # end run over rec["trials"], i.e. the combined set.
        rec["trials"] = [{**row, "resumed": True} for row in prior_rows]
        rec["resumed_from"] = {
            "file": os.path.basename(a.resume_from),
            "sha256": hashlib.sha256(
                Path(a.resume_from).read_bytes()).hexdigest(),
            "prior_trials": len(prior_rows),
            "resumed_copied": len(prior_rows),
        }
    else:
        done = set()
    os.makedirs(RESULTS, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S") + f"-{time.time_ns() % 1_000_000_000:09d}"
    out = os.path.join(RESULTS, f"{stamp}-outcome-{a.skill}-{a.agent}"
                                f"{'-heldout' if a.heldout else ''}.json")
    # Stall guard: a throttled free model hangs every call to the full
    # timeout. After N consecutive timeout/error observations, abort the
    # run (exit 5, partial results preserved) so the driver can retry on a live
    # model instead of burning hours on garbage.
    consec_bad = 0
    skipped = 0
    for task in tasks:
        for t in range(a.trials):
            if a.order == "alternating" and t % 2 == 1:
                conds = (("treatment", treat), ("baseline", None))
            else:
                conds = (("baseline", None), ("treatment", treat))
            for cond, ctx in conds:
                if (task["id"], cond, t + 1) in done:
                    skipped += 1
                    continue
                to = (a.timeout_override if a.timeout_override
                      else task.get("timeout", a.timeout))
                started = time.strftime("%Y-%m-%dT%H:%M:%S")
                prompt = build_prompt(task, cat, ctx)
                obs = observe(a.agent, prompt, cfg, to,
                              model=a.model, fixture=task.get("fixture"),
                              verify=task.get("verify"),
                              artifacts=task.get("artifacts"),
                              skill=a.skill if ctx else None)
                raw = obs.get("output", "")
                route = normalize_route(raw)
                passed, notes = grade(task, route, raw, obs)
                rec["trials"].append({"task": task["id"], "condition": cond,
                                     "trial": t + 1, "pass": passed,
                                     "first": conds[0][0],
                                     "timeout_s": to, "started": started,
                                     "prompt_chars": len(prompt),
                                     "notes": notes, "obs": obs})
                consec_bad = consec_bad + 1 if obs.get("status") != "ok" else 0
                abort = max_consec and consec_bad >= max_consec
                if abort:
                    rec["status"] = "aborted"
                save_result(rec, out)
                if abort:
                    print(f"ABORT: {consec_bad} consecutive bad observations; "
                          f"partial results: {out}", file=sys.stderr)
                    return 5
                detail = f"route={route}" if route else \
                    f"personas={notes.get('persona_count')}"
                print(f"{task['id']} {cond} t{t+1}: "
                      f"{'PASS' if passed else 'FAIL'} {detail} "
                      f"({obs.get('duration', '?')}s)")
                sys.stdout.flush()

    rec["status"] = "complete"
    save_result(rec, out)
    print(f"wrote {out} (resumed-skipped: {skipped})")

    # summary: pass rate per task/condition + key size metric
    for task in tasks:
        for cond in ("baseline", "treatment"):
            rows = [r for r in rec["trials"]
                    if r["task"] == task["id"] and r["condition"] == cond]
            pr = sum(r["pass"] for r in rows) / max(len(rows), 1)
            if isinstance(task["expected"], dict) and task["expected"].get("type") == "hotseat":
                vals = [r["notes"].get("persona_count", 0) for r in rows]
                print(f"{task['id']} {cond}: pass={pr:.2f} "
                      f"mean_personas={sum(vals)/max(len(vals),1):.2f}")
            elif isinstance(task["expected"], dict) and task["expected"].get("type") == "spelunk":
                vals = [r["notes"].get("recall", 0) for r in rows]
                print(f"{task['id']} {cond}: pass={pr:.2f} "
                      f"mean_recall={sum(vals)/max(len(vals),1):.2f}")
            elif isinstance(task["expected"], dict) and task["expected"].get("type") == "pilot":
                vals = [len(r["notes"].get("outside_scope", [])) for r in rows]
                print(f"{task['id']} {cond}: pass={pr:.2f} "
                      f"mean_out_of_scope={sum(vals)/max(len(vals),1):.2f}")
            elif isinstance(task["expected"], dict) and task["expected"].get("type") == "blueprint":
                vals = [r["notes"].get("diagrams", 0) for r in rows]
                print(f"{task['id']} {cond}: pass={pr:.2f} "
                      f"mean_diagrams={sum(vals)/max(len(vals),1):.2f}")
            elif isinstance(task["expected"], dict) and task["expected"].get("type") in ("polish", "friction", "ditto", "frontpage"):
                vals = [r["notes"].get("files", 0) for r in rows]
                print(f"{task['id']} {cond}: pass={pr:.2f} "
                      f"mean_artifacts={sum(vals)/max(len(vals),1):.2f}")
            else:
                lens = [len(r["notes"].get("route") or []) for r in rows]
                ml = sum(lens) / max(len(lens), 1)
                print(f"{task['id']} {cond}: pass={pr:.2f} mean_len={ml:.2f}")
    return 2 if any(row["obs"].get("status") != "ok" for row in rec["trials"]) else 0


if __name__ == "__main__":
    sys.exit(main())
